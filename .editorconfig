root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# the java sources and the gradle scripts are written with tabs
[*.{java,gradle}]
indent_style = tab

[*.{json,yml,yaml,html,md}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

# the shipped frame textures are binary and are not edited by hand
[*.png]
insert_final_newline = false
trim_trailing_whitespace = false

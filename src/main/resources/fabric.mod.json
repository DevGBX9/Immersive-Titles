{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",

  "name": "${name}",
  "description": "Displays cinematic biome titles when entering a biome, with a large first-visit title and a compact title on later visits.",
  "authors": [
    "DevGBX9"
  ],
  "contact": {
    "homepage": "https://github.com/DevGBX9/Wanderer-s-Titles-",
    "sources": "https://github.com/DevGBX9/Wanderer-s-Titles-",
    "issues": "https://github.com/DevGBX9/Wanderer-s-Titles-/issues"
  },
  "license": "LGPL-3.0",

  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.devgx9.wanderers_titles.WandererTitles"
    ],
    "client": [
      "com.devgx9.wanderers_titles.client.WandererTitlesClient"
    ]
  },
  "mixins": [
    "wanderers_titles.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.11.4",
    "minecraft": "${minecraft_dependency}"
  }
}
